    this.resetWheelBtn.addEventListener('click', () => {
      if (confirm('¿Restablecer los nombres de ejemplo originales?')) {
        this.setDefaultItems();
        this.saveState();
        this.renderNamesList();
        this.drawWheel();
      }
    });

    // Agregar nombre
