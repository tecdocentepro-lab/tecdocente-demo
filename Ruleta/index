  initCanvas() {
    this.ctx = this.canvas.getContext('2d');
    this.fixCanvasDpi();
    window.addEventListener('resize', () => {
      this.fixCanvasDpi();
      this.drawWheel();
    });

    // Desbloquear audio en la primera interacción táctil o clic
    const unlockAudio = () => {
      this.sounds.init();
      window.removeEventListener('pointerdown', unlockAudio);
      window.removeEventListener('keydown', unlockAudio);
    };
    window.addEventListener('pointerdown', unlockAudio);
    window.addEventListener('keydown', unlockAudio);
  }

  fixCanvasDpi() {
    const dpr = window.devicePixelRatio || 1;
    const rect = this.canvas.getBoundingClientRect();
    const size = Math.round(rect.width) || 540;

    this.canvas.width = Math.round(size * dpr);
    this.canvas.height = Math.round(size * dpr);
    this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    this.displaySize = size;
  }

  initConfetti() {
    this.globalConfetti = new ConfettiEngine(document.getElementById('globalConfettiCanvas'));
    this.modalConfetti = new ConfettiEngine(document.getElementById('modalConfettiCanvas'));
  }

  // --- PERSISTENCIA LOCALSTORAGE ---
  loadState() {
    try {
      const savedItems = localStorage.getItem('roulette_items');
      if (savedItems) {
        this.items = JSON.parse(savedItems);
      } else {
        this.setDefaultItems();
      }

      const savedHistory = localStorage.getItem('roulette_history');
      if (savedHistory) {
        this.history = JSON.parse(savedHistory);
      }

      const soundPref = localStorage.getItem('roulette_sound_enabled');
      if (soundPref !== null) {
        this.sounds.enabled = soundPref === 'true';
        this.updateSoundBtnUI();
      }
    } catch (e) {
      console.error('Error al cargar datos:', e);
      this.setDefaultItems();
    }
  }

  saveState() {
    try {
      localStorage.setItem('roulette_items', JSON.stringify(this.items));
      localStorage.setItem('roulette_history', JSON.stringify(this.history));
      localStorage.setItem('roulette_sound_enabled', this.sounds.enabled.toString());
    } catch (e) {
      console.error('Error al guardar datos:', e);
