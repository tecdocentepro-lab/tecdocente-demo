      this.bulkModal.classList.remove('active');
    });

    this.saveBulkBtn.addEventListener('click', () => this.handleBulkAdd());

    // Limpiar todos
    this.clearAllBtn.addEventListener('click', () => {
      if (this.items.length === 0) return;
      if (confirm('¿Estás seguro de que deseas borrar todos los participantes?')) {
        this.items = [];
        this.saveState();
        this.renderNamesList();
        this.drawWheel();
      }
    });

    // Historial
    this.copyHistoryBtn.addEventListener('click', () => this.copyHistoryToClipboard());
    this.clearHistoryBtn.addEventListener('click', () => {
      if (this.history.length === 0) return;
      if (confirm('¿Borrar todo el historial de ganadores?')) {
        this.history = [];
        this.saveState();
        this.renderHistory();
      }
    });

    // Sonido toggle
    this.soundToggleBtn.addEventListener('click', () => {
      const enabled = this.sounds.toggle();
      this.updateSoundBtnUI();
      this.saveState();
      if (enabled) this.sounds.playTick();
    });

    // Pantalla completa
    this.fullscreenBtn.addEventListener('click', () => this.toggleFullscreen());

    // Modal de Ganador
    this.modalSpinAgainBtn.addEventListener('click', () => {
      this.closeWinnerModal();
      setTimeout(() => this.spin(), 300);
    });

    this.modalHideWinnerBtn.addEventListener('click', () => {
      if (this.lastWinner) {
        this.toggleItemActive(this.lastWinner.id, false);
      }
      this.closeWinnerModal();
    });

    this.modalKeepAndCloseBtn.addEventListener('click', () => {
      this.closeWinnerModal();
    });

    this.modalCloseXBtn.addEventListener('click', () => {
      this.closeWinnerModal();
    });

    // Cerrar modales con fondo
    this.winnerModal.addEventListener('click', (e) => {
      if (e.target === this.winnerModal) this.closeWinnerModal();
    });
    this.bulkModal.addEventListener('click', (e) => {
      if (e.target === this.bulkModal) this.bulkModal.classList.remove('active');
    });

    // Atajos de teclado
    window.addEventListener('keydown', (e) => {
      if (e.code === 'Space' && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
        e.preventDefault();
        if (this.winnerModal.classList.contains('active')) {
          this.closeWinnerModal();
        } else {
          this.spin();
        }
      }
      if (e.code === 'Escape') {
        this.closeWinnerModal();
        this.bulkModal.classList.remove('active');
      }
    });
  }

  updateSoundBtnUI() {
    if (this.sounds.enabled) {
      this.soundIcon.textContent = '🔊';
      this.soundLabel.textContent = 'Sonido ON';
      this.soundToggleBtn.classList.remove('muted');
    } else {
      this.soundIcon.textContent = '🔇';
      this.soundLabel.textContent = 'Sonido OFF';
      this.soundToggleBtn.classList.add('muted');
    }
  }

  toggleFullscreen() {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(() => {});
    } else {
      if (document.exitFullscreen) {
        document.exitFullscreen().catch(() => {});
      }
    }
  }

  // --- AGREGAR Y MANIPULAR NOMBRES ---
  addNewName() {
    const rawName = this.nameInput.value.trim();
    if (!rawName) return;

    const newItem = {
      id: 'item_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
      name: rawName,
      active: true,
      color: COLOR_PALETTE[this.items.length % COLOR_PALETTE.length]
    };

    this.items.push(newItem);
    this.nameInput.value = '';
    this.saveState();
    this.renderNamesList();
    this.drawWheel();

    // Scroll abajo
    this.namesList.scrollTop = this.namesList.scrollHeight;
  }

  handleBulkAdd() {
    const text = this.bulkTextarea.value;
    if (!text.trim()) return;

    // Separar por líneas o por comas
    const tokens = text.split(/[\n,;]+/);
    let addedCount = 0;

    tokens.forEach(token => {
      const name = token.trim();
      if (name) {
        this.items.push({
          id: 'item_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6),
          name: name,
          active: true,
          color: COLOR_PALETTE[this.items.length % COLOR_PALETTE.length]
        });
        addedCount++;
      }
    });

    if (addedCount > 0) {
      this.saveState();
      this.renderNamesList();
      this.drawWheel();
    }
    this.bulkModal.classList.remove('active');
  }

  deleteItem(id) {
    this.items = this.items.filter(item => item.id !== id);
    // Reasignar colores armónicamente
    this.items.forEach((item, idx) => {
      item.color = COLOR_PALETTE[idx % COLOR_PALETTE.length];
    });
    this.saveState();
    this.renderNamesList();
    this.drawWheel();
  }

  toggleItemActive(id, forceState = null) {
    const item = this.items.find(i => i.id === id);
    if (!item) return;

    item.active = forceState !== null ? forceState : !item.active;
    this.saveState();
    this.renderNamesList();
    this.drawWheel();
  }

  shuffleItems() {
    if (this.isSpinning || this.items.length < 2) return;
    
    // Algoritmo Fisher-Yates
    for (let i = this.items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [this.items[i], this.items[j]] = [this.items[j], this.items[i]];
    }

    // Actualizar colores para variedad visual
    this.items.forEach((item, idx) => {
      item.color = COLOR_PALETTE[idx % COLOR_PALETTE.length];
    });

    this.saveState();
    this.renderNamesList();
    this.drawWheel();

    // Pequeño sonido de barajado
    this.sounds.playTick();
  }

  getActiveItems() {
    return this.items.filter(item => item.active);
  }

  // --- RENDERIZADO DE LA LISTA DE NOMBRES ---
  renderNamesList() {
    this.namesList.innerHTML = '';
    const activeItems = this.getActiveItems();

    this.activeCountBadge.textContent = activeItems.length;
    this.listInfoText.textContent = `${activeItems.length} activos de ${this.items.length}`;

    if (this.items.length === 0) {
      this.namesList.innerHTML = `
        <div class="empty-state" style="padding: 1.5rem 1rem;">
          <span class="empty-icon" style="font-size: 2rem;">📝</span>
          <p style="font-size: 0.9rem;">No hay participantes</p>
          <small>Escribe un nombre arriba o pega una lista</small>
        </div>
      `;
      return;
    }

    this.items.forEach(item => {
      const itemEl = document.createElement('div');
      itemEl.className = `name-item ${!item.active ? 'disabled' : ''}`;

      itemEl.innerHTML = `
        <div class="name-item-left">
          <input type="checkbox" class="checkbox-toggle" ${item.active ? 'checked' : ''} title="${item.active ? 'Desmarcar para esconder' : 'Marcar para activar'}">
          <span class="name-color-dot" style="background-color: ${item.color}"></span>
          <span class="name-text" title="${this.escapeHtml(item.name)}">${this.escapeHtml(item.name)}</span>
        </div>
        <div class="name-item-actions">
          <button class="item-delete-btn" title="Eliminar participante">🗑️</button>
        </div>
      `;

      // Eventos individuales
      const checkbox = itemEl.querySelector('.checkbox-toggle');
      checkbox.addEventListener('change', () => {
        this.toggleItemActive(item.id, checkbox.checked);
      });

      const deleteBtn = itemEl.querySelector('.item-delete-btn');
      deleteBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        this.deleteItem(item.id);
      });

      this.namesList.appendChild(itemEl);
    });
  }

  // --- RENDERIZADO DEL HISTORIAL DE GANADORES ---
  renderHistory() {
    this.historyCountBadge.textContent = this.history.length;
    this.historyList.innerHTML = '';

    if (this.history.length === 0) {
      this.historyList.innerHTML = `
        <div class="empty-state">
          <span class="empty-icon">🎯</span>
          <p>Aún no hay ganadores seleccionados.</p>
          <small>¡Gira la ruleta para comenzar la lista!</small>
        </div>
      `;
      return;
    }

    this.history.forEach((record, index) => {
      const rank = this.history.length - index;
      const itemEl = document.createElement('div');
      itemEl.className = 'history-item';
      itemEl.innerHTML = `
        <div class="history-item-left">
          <span class="history-rank">#${rank}</span>
          <span class="history-name">${this.escapeHtml(record.name)}</span>
        </div>
        <span class="history-time">${record.time}</span>
      `;
      this.historyList.appendChild(itemEl);
    });
  }

  copyHistoryToClipboard() {
    if (this.history.length === 0) {
      alert('El historial está vacío.');
      return;
    }

    const lines = this.history.map((h, i) => `${this.history.length - i}. ${h.name} (${h.time})`);
    const text = "🏆 GANADORES DE LA RULETA 🏆\n" + lines.join("\n");

    navigator.clipboard.writeText(text).then(() => {
      alert('¡Lista de ganadores copiada al portapapeles! 📋');
    }).catch(() => {
      alert('No se pudo copiar automáticamente.');
    });
  }

  // --- DIBUJADO DE LA RULETA EN CANVAS ---
  drawWheel() {
    const ctx = this.ctx;
    const size = this.displaySize;
    const cx = size / 2;
    const cy = size / 2;
    const radius = cx - 18;

    ctx.clearRect(0, 0, size, size);

    const activeItems = this.getActiveItems();
    const count = activeItems.length;

    // Si no hay participantes activos
    if (count === 0) {
      this.drawEmptyWheel(ctx, cx, cy, radius);
      return;
    }

    const sliceAngle = (2 * Math.PI) / count;

    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(this.currentAngle);

    // 1. Dibujar rebanadas (Slices)
    for (let i = 0; i < count; i++) {
      const item = activeItems[i];
      const startAngle = i * sliceAngle;
      const endAngle = startAngle + sliceAngle;

      // Rebanada
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.arc(0, 0, radius, startAngle, endAngle);
      ctx.closePath();

      // Gradiente suave radial para darle volumen
      const grad = ctx.createRadialGradient(0, 0, radius * 0.1, 0, 0, radius);
      grad.addColorStop(0, '#ffffff20');
      grad.addColorStop(0.3, item.color);
      grad.addColorStop(1, this.shadeColor(item.color, -20));

      ctx.fillStyle = grad;
      ctx.fill();

      // Borde sutil entre rebanadas
      ctx.lineWidth = 2;
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
      ctx.stroke();

      // Clavijas perimetrales (pegs) en cada división
      const pegX = Math.cos(startAngle) * (radius - 8);
      const pegY = Math.sin(startAngle) * (radius - 8);
      ctx.beginPath();
      ctx.arc(pegX, pegY, 4, 0, 2 * Math.PI);
      ctx.fillStyle = '#ffffff';
      ctx.shadowColor = 'rgba(0,0,0,0.5)';
      ctx.shadowBlur = 4;
      ctx.fill();
      ctx.shadowBlur = 0;

      // 2. Texto de la rebanada
      ctx.save();
      ctx.rotate(startAngle + sliceAngle / 2);
      ctx.textAlign = 'right';
      ctx.textBaseline = 'middle';

      // Ajuste dinámico de fuente según número de items
      let fontSize = 20;
      if (count > 24) fontSize = 12;
      else if (count > 16) fontSize = 14;
      else if (count > 10) fontSize = 16;
      else if (count > 6) fontSize = 18;

      ctx.font = `bold ${fontSize}px 'Outfit', sans-serif`;
      
      // Sombra para legibilidad del texto
      ctx.shadowColor = 'rgba(0, 0, 0, 0.8)';
      ctx.shadowBlur = 6;
      ctx.fillStyle = '#ffffff';

      // Truncar texto si es muy largo para el radio
      let label = item.name;
      const maxTextWidth = radius - 80;
      if (ctx.measureText(label).width > maxTextWidth) {
        while (ctx.measureText(label + '…').width > maxTextWidth && label.length > 3) {
          label = label.slice(0, -1);
        }
        label += '…';
      }

      ctx.fillText(label, radius - 26, 0);
      ctx.restore();
    }

    ctx.restore();

    // 3. Anillo exterior con luces estilo casino
    this.drawArcadeRim(ctx, cx, cy, radius, count);
  }

  // Borde exterior decorativo con luces LED parpadeantes
  drawArcadeRim(ctx, cx, cy, radius, count) {
    const rimWidth = 14;
    ctx.save();
    
    // Aro exterior metálico / dorado
    const rimGrad = ctx.createLinearGradient(0, 0, cx * 2, cy * 2);
    rimGrad.addColorStop(0, '#ffd700');
    rimGrad.addColorStop(0.5, '#ff8c00');
    rimGrad.addColorStop(1, '#ff007f');

    ctx.beginPath();
    ctx.arc(cx, cy, radius + rimWidth / 2, 0, 2 * Math.PI);
    ctx.lineWidth = rimWidth;
    ctx.strokeStyle = rimGrad;
    ctx.stroke();

    // Luces LED alrededor del borde
    const numLights = 28;
    const lightAngle = (2 * Math.PI) / numLights;
    const now = Date.now() / 300;

    for (let i = 0; i < numLights; i++) {
      const angle = i * lightAngle;
      const lx = cx + Math.cos(angle) * (radius + rimWidth / 2);
      const ly = cy + Math.sin(angle) * (radius + rimWidth / 2);

      // Alternar parpadeo
      const isLit = this.isSpinning 
        ? Math.sin(now * 3 + i) > 0 
        : i % 2 === 0;

      ctx.beginPath();
      ctx.arc(lx, ly, 3.5, 0, 2 * Math.PI);
      ctx.fillStyle = isLit ? '#ffffff' : '#ffd700';
      if (isLit) {
        ctx.shadowColor = '#ffffff';
        ctx.shadowBlur = 8;
      }
      ctx.fill();
      ctx.shadowBlur = 0;
    }

    ctx.restore();
  }

  drawEmptyWheel(ctx, cx, cy, radius) {
    ctx.save();
    ctx.beginPath();
    ctx.arc(cx, cy, radius, 0, 2 * Math.PI);
    ctx.fillStyle = 'rgba(255, 255, 255, 0.05)';
    ctx.fill();
    ctx.lineWidth = 4;
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
    ctx.setLineDash([8, 8]);
    ctx.stroke();

    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillStyle = '#a0aec0';
    ctx.font = "bold 18px 'Outfit', sans-serif";
    ctx.fillText('¡Agrega participantes para girar!', cx, cy);
    ctx.restore();
  }

  // --- FÍSICA Y ANIMACIÓN DEL GIRO ---
  spin() {
    if (this.isSpinning) return;

    const activeItems = this.getActiveItems();
    if (activeItems.length < 1) {
      alert('¡Debes tener al menos 1 nombre activo para girar!');
      return;
    }

    if (activeItems.length === 1) {
      this.celebrateWinner(activeItems[0]);
      return;
    }

    this.isSpinning = true;
    this.setControlsDisabled(true);

    // Obtener duración del giro según selector
    const durationSeconds = parseFloat(this.spinDurationSelect.value) || 6;
    const totalDuration = durationSeconds * 1000;

    // Calcular giros completos aleatorios (entre 5 y 8 vueltas completas) + ángulo aleatorio
    const fullSpins = 5 + Math.floor(Math.random() * 4);
    const extraAngle = Math.random() * (2 * Math.PI);
    const targetTotalRotation = (fullSpins * 2 * Math.PI) + extraAngle;

    const startAngle = this.currentAngle;
    const targetAngle = startAngle + targetTotalRotation;

    const startTime = performance.now();
    this.lastPegIndex = -1;

    const sliceAngle = (2 * Math.PI) / activeItems.length;
    const topAngle = 1.5 * Math.PI; // 270 grados (donde apunta la aguja superior)

    // Curva de desaceleración realista: easeOutQuint o easeOutCubic
    const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
    const easeOutQuint = (t) => 1 - Math.pow(1 - t, 5);

    const animate = (currentTime) => {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / totalDuration, 1);
      
      // Aplicar easing
      const easedProgress = easeOutQuint(progress);
      this.currentAngle = startAngle + (targetTotalRotation * easedProgress);

      // Calcular clavija actual bajo la aguja para emitir el "clack" y animar el flapper
      let relativeAngle = (topAngle - (this.currentAngle % (2 * Math.PI))) % (2 * Math.PI);
      if (relativeAngle < 0) relativeAngle += 2 * Math.PI;
      const currentPeg = Math.floor(relativeAngle / sliceAngle);

      if (currentPeg !== this.lastPegIndex) {
        this.lastPegIndex = currentPeg;
        this.triggerNeedleTick();
      }

      this.drawWheel();

      if (progress < 1) {
        requestAnimationFrame(animate);
      } else {
        this.currentAngle = targetAngle % (2 * Math.PI);
        this.drawWheel();
        this.isSpinning = false;
        this.setControlsDisabled(false);

        // Determinar ganador
        const winningIndex = this.getWinningIndex(activeItems.length);
        const winner = activeItems[winningIndex];
        this.celebrateWinner(winner);
      }
    };

    requestAnimationFrame(animate);
  }

  // Calcula exactamente qué rebanada está bajo la aguja en el tope (270°)
  getWinningIndex(totalActive) {
    const topAngle = 1.5 * Math.PI;
    const sliceAngle = (2 * Math.PI) / totalActive;

    let relativeAngle = (topAngle - (this.currentAngle % (2 * Math.PI))) % (2 * Math.PI);
    if (relativeAngle < 0) relativeAngle += 2 * Math.PI;

    return Math.floor(relativeAngle / sliceAngle);
  }

  // Sacudida física de la aguja con sonido
  triggerNeedleTick() {
    this.sounds.playTick();
    this.pointer.classList.remove('tick-bump');
    // Forzar reflow para reiniciar animación CSS
    void this.pointer.offsetWidth;
    this.pointer.classList.add('tick-bump');
  }

  setControlsDisabled(disabled) {
    this.spinBtn.disabled = disabled;
    this.centerSpinBtn.disabled = disabled;
    this.shuffleBtn.disabled = disabled;
    this.resetWheelBtn.disabled = disabled;
  }

  // --- CELEBRACIÓN Y MODAL DE GANADOR ---
  celebrateWinner(winner) {
    this.lastWinner = winner;

    // Registrar en historial
    const now = new Date();
    const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    this.history.unshift({
      id: 'win_' + Date.now(),
      name: winner.name,
      time: timeStr
    });
    this.saveState();
    this.renderHistory();

    // Reproducir fanfarria de victoria
    this.sounds.playVictory();

    // Disparar confeti global y en el modal
    this.globalConfetti.explode(180);
    setTimeout(() => {
      this.modalConfetti.explode(120);
    }, 250);

    // Preparar y mostrar modal
    this.winnerNameText.textContent = winner.name;
    this.winnerSubtitle.textContent = `¡Seleccionado en el giro #${this.history.length}!`;
    this.winnerModal.classList.add('active');
  }

  closeWinnerModal() {
    this.winnerModal.classList.remove('active');
    this.modalConfetti.stop();
  }

  // --- UTILIDADES ---
  escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  shadeColor(color, percent) {
    let R = parseInt(color.substring(1, 3), 16);
    let G = parseInt(color.substring(3, 5), 16);
    let B = parseInt(color.substring(5, 7), 16);

    R = parseInt((R * (100 + percent)) / 100);
    G = parseInt((G * (100 + percent)) / 100);
    B = parseInt((B * (100 + percent)) / 100);

    R = (R < 255) ? R : 255;
    G = (G < 255) ? G : 255;
    B = (B < 255) ? B : 255;

    const RR = ((R.toString(16).length === 1) ? '0' + R.toString(16) : R.toString(16));
    const GG = ((G.toString(16).length === 1) ? '0' + G.toString(16) : G.toString(16));
    const BB = ((B.toString(16).length === 1) ? '0' + B.toString(16) : B.toString(16));

    return '#' + RR + GG + BB;
  }
}

// Iniciar aplicación cuando el DOM esté listo
window.addEventListener('DOMContentLoaded', () => {
  sincronizarEnlacesOficiales();
  window.app = new RouletteApp();
});

