// --- FUNCIÓN DE AUTO-DESCARGA LIMPIA OFFLINE ---
async function descargarRuletaOffline() {
  const nombreArchivo = "Ruleta_TecDocente_Pro.html";
  let htmlContenido = null;

  // 1. Si está alojada en servidor web (http/https), obtener el HTML original limpio
  if (window.location.protocol.startsWith('http')) {
    try {
      const response = await fetch(window.location.href, { cache: 'no-store' });
      if (response.ok) {
        const rawHtml = await response.text();
        if (rawHtml && rawHtml.trim().length > 0) {
          htmlContenido = rawHtml;
        }
      }
    } catch (error) {
      console.warn('No se pudo obtener la copia desde el servidor, generando respaldo local:', error);
    }
  }

  // 2. Respaldo (fallback si falla el fetch o si ya se abrió localmente como file://)
  if (!htmlContenido) {
    const clone = document.documentElement.cloneNode(true);

    const namesListClone = clone.querySelector('#namesList');
    if (namesListClone) namesListClone.innerHTML = '';

    const historyListClone = clone.querySelector('#historyList');
    if (historyListClone) historyListClone.innerHTML = '';

    clone.querySelectorAll('.modal-overlay').forEach(overlay => {
      overlay.classList.remove('active');
    });

    const activeCountClone = clone.querySelector('#activeCountBadge');
    if (activeCountClone) activeCountClone.textContent = '0';

    const historyCountClone = clone.querySelector('#historyCountBadge');
    if (historyCountClone) historyCountClone.textContent = '0';

    const listInfoClone = clone.querySelector('#listInfoText');
    if (listInfoClone) listInfoClone.textContent = '0 en ruleta';

    const downloadBtnClone = clone.querySelector('#downloadOfflineBtn');
    if (downloadBtnClone) {
      downloadBtnClone.removeAttribute('data-downloading');
      downloadBtnClone.innerHTML = '<span class="icon">📥</span><span class="btn-label">Descargar para PC (Sin Internet)</span>';
    }

    htmlContenido = '<!DOCTYPE html>\n' + clone.outerHTML;
  }

  // 3. Crear Blob y forzar descarga como Ruleta_TecDocente_Pro.html
  const blob = new Blob([htmlContenido], { type: 'text/html;charset=utf-8' });
  const blobUrl = URL.createObjectURL(blob);

  const link = document.createElement('a');
  link.href = blobUrl;
  link.download = nombreArchivo;
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);

  setTimeout(() => URL.revokeObjectURL(blobUrl), 2000);

  // Confirmación visual breve en el botón (después del clon para no alterar el archivo guardado)
  const btn = document.getElementById('downloadOfflineBtn');
  if (btn && !btn.dataset.downloading) {
    const htmlOriginal = btn.innerHTML;
    btn.dataset.downloading = '1';
    btn.innerHTML = '<span class="icon">✅</span><span class="btn-label">¡Guardado para PC!</span>';
    setTimeout(() => {
      btn.innerHTML = htmlOriginal;
      delete btn.dataset.downloading;
    }, 2400);
  }
}

